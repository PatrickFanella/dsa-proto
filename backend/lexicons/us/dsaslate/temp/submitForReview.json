{
  "lexicon": 1,
  "id": "us.dsaslate.temp.submitForReview",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["collection", "record"],
          "properties": {
            "collection": { "type": "string", "format": "nsid" },
            "record": { "type": "unknown" },
            "reason": { "type": "string", "maxLength": 1000, "maxGraphemes": 500 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "required": ["operation"], "properties": { "operation": { "type": "ref", "ref": "us.dsaslate.temp.defs#reviewOperation" } } }
      }
    }
  }
}
