{
  "lexicon": 1,
  "id": "us.dsaslate.temp.getOrgGraph",
  "defs": {
    "main": {
      "type": "query",
      "parameters": { "type": "params", "properties": { "cursor": { "type": "string", "maxLength": 512 }, "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } } },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["entities", "relationships"],
          "properties": {
            "entities": { "type": "array", "maxLength": 100, "items": { "type": "ref", "ref": "us.dsaslate.temp.defs#entityView" } },
            "relationships": { "type": "array", "maxLength": 500, "items": { "type": "unknown" } },
            "cursor": { "type": "string", "maxLength": 512 }
          }
        }
      }
    }
  }
}
