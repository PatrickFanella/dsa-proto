{
  "lexicon": 1,
  "id": "us.dsaslate.temp.authorityDelegation",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["delegateDid", "entityUris", "collections", "actions", "effectiveFrom", "createdAt"],
        "properties": {
          "delegateDid": { "type": "string", "format": "did" },
          "entityUris": {
            "type": "array",
            "maxLength": 100,
            "items": { "type": "string", "format": "at-uri" }
          },
          "collections": {
            "type": "array",
            "maxLength": 32,
            "items": { "type": "string", "format": "nsid" }
          },
          "actions": {
            "type": "array",
            "maxLength": 5,
            "items": { "type": "string", "knownValues": ["create", "update", "delete", "attest", "delegate"] }
          },
          "effectiveFrom": { "type": "string", "format": "datetime" },
          "effectiveUntil": { "type": "string", "format": "datetime" },
          "parent": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
