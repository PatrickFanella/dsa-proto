{
  "lexicon": 1,
  "id": "us.dsaslate.temp.identityTransition",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["entity", "fromDid", "toDid", "reason", "effectiveAt"],
        "properties": {
          "entity": { "type": "string", "format": "at-uri" },
          "fromDid": { "type": "string", "format": "did" },
          "toDid": { "type": "string", "format": "did" },
          "fromProfile": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "toProfile": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "reason": { "type": "string", "maxLength": 1000, "maxGraphemes": 500 },
          "effectiveAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
