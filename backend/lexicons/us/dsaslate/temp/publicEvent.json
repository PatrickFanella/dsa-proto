{
  "lexicon": 1,
  "id": "us.dsaslate.temp.publicEvent",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["hostEntity", "title", "startsAt", "mode", "status", "createdAt"],
        "properties": {
          "hostEntity": { "type": "string", "format": "at-uri" },
          "title": { "type": "string", "maxLength": 300, "maxGraphemes": 150 },
          "description": { "type": "string", "maxLength": 3000, "maxGraphemes": 1500 },
          "startsAt": { "type": "string", "format": "datetime" },
          "endsAt": { "type": "string", "format": "datetime" },
          "mode": { "type": "string", "knownValues": ["online", "inPerson", "hybrid"] },
          "publicUrl": { "type": "string", "format": "uri" },
          "locationLabel": { "type": "string", "maxLength": 300, "maxGraphemes": 150 },
          "status": { "type": "string", "knownValues": ["scheduled", "cancelled", "archived"] },
          "topics": {
            "type": "array",
            "maxLength": 20,
            "items": { "type": "string", "maxLength": 64, "maxGraphemes": 32 }
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
