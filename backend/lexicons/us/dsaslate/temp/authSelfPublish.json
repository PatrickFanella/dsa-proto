{
  "lexicon": 1,
  "id": "us.dsaslate.temp.authSelfPublish",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "DSA Slate public organization records",
      "detail": "Create, update, or remove the organization's public profile and event records.",
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "collection": ["us.dsaslate.temp.orgProfile", "us.dsaslate.temp.publicEvent"],
          "action": ["create", "update", "delete"]
        }
      ]
    }
  }
}
