{
  "name": "@subculture/dsa-proto-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "ingest:atproto": "tsx src/ingest-atproto.ts",
    "sync:tap": "tsx src/foundation-tap-worker.ts",
    "foundation:publish": "tsx src/foundation-publish.ts",
    "fixtures:replay": "tsx src/fixtures-replay.ts",
    "fixtures:author": "tsx src/fixtures-author.ts",
    "registry:health": "tsx src/registry-health.ts",
    "chapters:import": "tsx src/chapters-csv-import.ts",
    "caucuses:import": "tsx src/caucuses-csv-import.ts",
    "lexicons": "lex build --lexicons lexicons --out src/lexicons --clear --pretty=false --index-file",
    "lexicons:compat": "tsx src/lexicon-compatibility.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run src",
    "format": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@atproto/identity": "^0.5.3",
    "@atproto/lex": "^0.2.1",
    "@atproto/oauth-client-node": "^0.4.7",
    "@atproto/syntax": "^0.7.1",
    "@atproto/sync": "^0.3.7",
    "@atproto/tap": "^0.3.7",
    "@ipld/dag-cbor": "^9.2.5",
    "multiformats": "^14.0.4",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
