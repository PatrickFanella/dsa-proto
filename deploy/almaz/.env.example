PUBLIC_HOST=demo.dsaslate.us
PUBLIC_BASE_URL=https://demo.dsaslate.us
CORS_ORIGIN=https://demo.dsaslate.us

DEMO_READ_ONLY=true
ENABLE_ADMIN_INGEST=false
AUTO_REPLAY_FIXTURES=false
REQUIRE_POSTGRES=true

POSTGRES_DB=dsa_proto_demo
POSTGRES_USER=dsa_proto_demo
# Use a generated URL-safe password because DATABASE_URL embeds this value.
# Avoid reserved URL characters such as @ / ? # % unless percent-encoded.
POSTGRES_PASSWORD=change-me-use-a-generated-secret

API_PORT=18080
WEB_PORT=18081
