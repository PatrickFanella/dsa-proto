http://pds-staging.dsaslate.us {
  encode zstd gzip

  # The OAuth provider rejects `same-site` navigations even though it accepts
  # equivalent `cross-site` top-level navigations. Our staging applications and
  # PDS intentionally use sibling dsaslate.us hosts, so normalize only the
  # authorization-page document navigation. All other fetch-metadata checks
  # remain untouched inside the provider.
  @same_site_oauth_navigation {
    path /oauth/authorize
    header Sec-Fetch-Site same-site
    header Sec-Fetch-Mode navigate
    header Sec-Fetch-Dest document
  }
  reverse_proxy @same_site_oauth_navigation pds:3000 {
    header_up Sec-Fetch-Site cross-site
  }
  reverse_proxy pds:3000
}

http://api-staging.dsaslate.us {
  encode zstd gzip

  @did path /.well-known/did.json
  header @did Content-Type application/did+json
  respond @did `{"@context":["https://www.w3.org/ns/did/v1"],"id":"did:web:api-staging.dsaslate.us","service":[{"id":"did:web:api-staging.dsaslate.us#dsaslate_appview","type":"DSASlateAppView","serviceEndpoint":"https://api-staging.dsaslate.us"}]}` 200

  reverse_proxy api:8080
}

http://app-staging.dsaslate.us {
  encode zstd gzip

  @backend path /oauth/* /api/* /xrpc/* /health /ready
  reverse_proxy @backend api:8080
  reverse_proxy web:80
}
